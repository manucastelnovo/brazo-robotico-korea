# Browser-side bridge URL. Keep "localhost" (not 127.0.0.1): the session cookie set on
# localhost:3000 is then also sent to the bridge WebSocket on localhost:8765.
NEXT_PUBLIC_BRIDGE_URL=http://localhost:8765
# Server-to-server bridge URL used by the route handlers.
BRIDGE_INTERNAL_URL=http://127.0.0.1:8765
# Must match HUENIT_FACE_STREAK on the bridge (display only).
NEXT_PUBLIC_REQUIRED_STREAK=3
# Optional: override the shared secret file (web_app/.session_secret). Must match the bridge.
# HUENIT_SESSION_SECRET=
